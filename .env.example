# Required: use the same Supabase project URL and publishable key in both pairs.
# VITE_* values are public and included in the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only: required for trusted admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: cron authentication (previous secret is optional during rotation).
CRON_SECRET=
CRON_SECRET_PREVIOUS=

# Optional server-only voice services: Groq STT and Lovable STT/TTS.
GROQ_API_KEY=
LOVABLE_API_KEY=

# Optional Sarvam browser SDK overrides. All VITE_* values are public.
# Only use a browser-safe credential here, never a private provider key.
VITE_SARVAM_API_KEY=
VITE_SARVAM_ORG_ID=
VITE_SARVAM_WORKSPACE_ID=
VITE_SARVAM_APP_ID=

# Optional Beacon integration (server-only). Create a read-only key in Beacon's External app API panel.
BEACON_ENDPOINT=
BEACON_PROJECT_KEY=
# Comma-separated Supabase Auth user UUIDs permitted to view the connected Beacon project.
# Empty denies everyone. Grant only to users authorized to see this Beacon project's issues.
BEACON_ALLOWED_USER_IDS=

# Server-only, stable 32-byte hex key for encrypted Beacon settings. Generate with openssl rand -hex 32.
BEACON_ENCRYPTION_KEY=
